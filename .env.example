# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- WhatsApp Cloud API (same Meta app / number as n8n) ---
WHATSAPP_PHONE_NUMBER_ID=1483995271455253
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_API_VERSION=v21.0

# --- n8n <-> dashboard ---
# Long random string. Put the same value in n8n's Header Auth credential (header name: x-n8n-secret).
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Optional: Production URL of the "Run AI Now" webhook in n8n (N8N_CHANGES.md step 8)
N8N_TRIGGER_AI_WEBHOOK_URL=

# --- Timed pauses ("pause for 30 min") are resumed by Vercel Cron calling /api/cron/auto-resume ---
CRON_SECRET=change-me-too

# Demo mode: runs on sample data with no login and sends nothing.
# Turns on automatically while NEXT_PUBLIC_SUPABASE_URL is the placeholder above.
# NEXT_PUBLIC_DEMO_MODE=true
