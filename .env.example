# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- WhatsApp Cloud API (same Meta app / number as n8n) ---
WHATSAPP_PHONE_NUMBER_ID=1483995271455253
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_API_VERSION=v21.0

# --- n8n <-> dashboard ---
# Long random string. Put the same value in n8n's Header Auth credential (header name: x-n8n-secret).
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Optional: Production URL of the "Run AI Now" webhook in n8n (N8N_CHANGES.md step 8)
N8N_TRIGGER_AI_WEBHOOK_URL=

# --- Timed pauses ("pause for 30 min") are resumed by Vercel Cron calling /api/cron/auto-resume ---
CRON_SECRET=change-me-too

# Demo mode (local preview only): sample data, nothing sent. Never on in production.
# Turns on automatically while NEXT_PUBLIC_SUPABASE_URL is the placeholder above.
# NEXT_PUBLIC_DEMO_MODE=true

# Optional: signs demo-mode login cookies (live mode uses Supabase Auth). Any long random string.
# AUTH_SECRET=

# --- Broadcasts ---
# Approved WhatsApp template used for customers who last wrote more than 24 h ago.
# Body variables: {{1}} = customer first name, {{2}} = product line(s). Leave empty to skip those customers.
WHATSAPP_BROADCAST_TEMPLATE=
WHATSAPP_BROADCAST_TEMPLATE_LANG=en

# --- AI broadcast suggestions (optional) ---
# Your own Anthropic API key. Without it, suggestions still work (rule-based) but Claude doesn't write the copy.
CLAUDE_API_KEY=

# --- Customer payment tiers (lifetime spend in AED) ---
TIER_HIGH_MIN_AED=500000
TIER_MEDIUM_MIN_AED=200000

# Business currency (the prices in the n8n Google Sheet), e.g. USD
NEXT_PUBLIC_CURRENCY=USD
# Google Sheet used by npm run import-sheet-db (must be shared "Anyone with the link can view")
GOOGLE_SHEET_ID=1DiZqu62aIY4uqWiGBTLEVVexuxOQpmwlzI8w79IWXH0
